---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlanCard from '../components/PlanCard.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import CallToAction from '../components/CallToAction.astro';
import { plans } from '../data/gym';

const comparison = [
  { feature: '24/7 gym access', values: [true, true, true] },
  { feature: 'Unlimited group classes', values: [false, true, true] },
  { feature: 'Mobility & recovery sessions', values: [false, true, true] },
  { feature: 'Quarterly progress check-in', values: [false, true, true] },
  { feature: 'Personal coaching sessions', values: [false, false, '2 / month'] },
  { feature: 'Individual training program', values: [false, false, true] },
  { feature: 'Nutrition check-in', values: [false, false, 'Monthly'] },
  { feature: 'Direct coach messaging', values: [false, false, true] },
];
---
<BaseLayout title="Pricing" description="Simple, flexible gym memberships from $49 per month. Compare FORGE Open Gym, All Access, and 1:1 coaching plans.">
  <PageHero
    eyebrow="Membership pricing"
    title="Simple pricing."
    accent="No surprises."
    description="Start with a free session, then choose the level of support that fits your goals. No joining fee and no hard sell."
  >
    <a class="text-link" href="#plans">Compare plans<Icon name="arrow-right" size={16} /></a>
  </PageHero>

  <section class="section pricing-section" id="plans">
    <div class="container">
      <div class="pricing-toolbar">
        <div>
          <p class="eyebrow">Choose your membership</p>
          <h2 class="section-title section-title--small">Invest in feeling capable.</h2>
        </div>
        <div class="billing-control">
          <div class="billing-toggle" role="group" aria-label="Billing period">
            <button type="button" data-billing-option="monthly" aria-pressed="true">Monthly</button>
            <button type="button" data-billing-option="annual" aria-pressed="false">Annual <span>Save 15%</span></button>
          </div>
          <p data-billing-description>Flexible monthly billing. Cancel with 30 days’ notice.</p>
        </div>
      </div>
      <div class="card-grid pricing-grid">
        {plans.map((plan) => <PlanCard plan={plan} />)}
      </div>
      <div class="pricing-assurances">
        <span><Icon name="check" size={18} />No joining fee</span>
        <span><Icon name="check" size={18} />Free first session</span>
        <span><Icon name="check" size={18} />Pause when life happens</span>
        <span><Icon name="check" size={18} />30-day cancellation</span>
      </div>
    </div>
  </section>

  <section class="section section--white comparison-section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">Side by side</p>
          <h2 class="section-title section-title--small">Find your best fit.</h2>
        </div>
        <p class="meta">All prices in USD · tax included</p>
      </div>
      <div class="comparison-scroll" tabindex="0" role="region" aria-label="Membership comparison table">
        <table>
          <thead><tr><th scope="col">Membership feature</th>{plans.map((plan) => <th scope="col" class:list={[{ featured: plan.featured }]}>{plan.name}</th>)}</tr></thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                {row.values.map((value, index) => <td class:list={[{ featured: plans[index].featured }]}>
                  {value === true ? <><Icon name="check" size={18} /><span class="sr-only">Included</span></> : value === false ? <><span aria-hidden="true">—</span><span class="sr-only">Not included</span></> : <span>{value}</span>}
                </td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section membership-every">
    <div class="container membership-every__grid">
      <div>
        <p class="eyebrow">Standard at FORGE</p>
        <h2 class="section-title section-title--small">Every member gets the essentials.</h2>
      </div>
      <div class="essentials-grid">
        <article><Icon name="users" size={25} /><h3>A real welcome</h3><p>A guided tour, goal conversation, and first workout with a coach.</p></article>
        <article><Icon name="target" size={25} /><h3>Quality equipment</h3><p>Well-maintained kit, dedicated platforms, and space to train properly.</p></article>
        <article><Icon name="clock" size={25} /><h3>Time that works</h3><p>Secure 24/7 access and a schedule that includes early, late, and weekends.</p></article>
        <article><Icon name="activity" size={25} /><h3>Room to recover</h3><p>Mobility space, recovery tools, clean showers, and fresh towels.</p></article>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container faq-grid">
      <div>
        <p class="eyebrow">Membership FAQ</p>
        <h2 class="section-title section-title--small">The fine print, in plain English.</h2>
        <p>Need to talk through a specific situation? We’re happy to help before you make a decision.</p>
        <a class="text-link" href="/contact">Ask a question<Icon name="arrow-up-right" size={16} /></a>
      </div>
      <FaqList />
    </div>
  </section>

  <CallToAction title="Try us first." accent="Decide later." description="One free session, a full tour, and honest answers. You don’t need a membership—or card details—to visit." />
</BaseLayout>

<script>
  type BillingPeriod = 'monthly' | 'annual';
  const billingButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-billing-option]')];
  const prices = [...document.querySelectorAll<HTMLElement>('[data-price]')];
  const billingNotes = [...document.querySelectorAll<HTMLElement>('[data-billing-note]')];
  const description = document.querySelector<HTMLElement>('[data-billing-description]');
  const planLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[href^="/contact?plan="]')];

  const setBilling = (period: BillingPeriod) => {
    billingButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.billingOption === period)));
    prices.forEach((price) => { price.textContent = period === 'annual' ? price.dataset.annual ?? '' : price.dataset.monthly ?? ''; });
    billingNotes.forEach((note) => {
      note.textContent = period === 'annual'
        ? `Billed $${note.dataset.annualTotal} yearly · save $${note.dataset.annualSavings}`
        : 'Billed monthly · cancel anytime';
    });
    planLinks.forEach((link) => {
      const url = new URL(link.href);
      url.searchParams.set('billing', period);
      link.href = `${url.pathname}${url.search}`;
    });
    if (description) description.textContent = period === 'annual'
      ? 'One annual payment. Your best monthly equivalent rate.'
      : 'Flexible monthly billing. Cancel with 30 days’ notice.';
  };

  billingButtons.forEach((button) => button.addEventListener('click', () => setBilling(button.dataset.billingOption as BillingPeriod)));
</script>

<style>
  .pricing-section { scroll-margin-top: var(--header-height); }
  .pricing-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 66px; }
  .billing-control { display: grid; justify-items: end; gap: 12px; }
  .billing-toggle { display: flex; padding: 4px; border: 1px solid var(--line); border-radius: 100px; background: var(--white); }
  .billing-toggle button { min-height: 42px; padding: 9px 18px; border-radius: 100px; background: transparent; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
  .billing-toggle button[aria-pressed='true'] { background: var(--ink); color: var(--white); }
  .billing-toggle button span { margin-left: 5px; color: #526900; font-size: 0.58rem; }
  .billing-toggle button[aria-pressed='true'] span { color: var(--lime); }
  .billing-control > p { color: var(--muted); font-size: 0.66rem; }
  .pricing-grid { padding-top: 14px; }
  .pricing-assurances { display: flex; flex-wrap: wrap; justify-content: center; gap: 18px 36px; margin-top: 46px; color: var(--muted); font-size: 0.7rem; font-weight: 700; }
  .pricing-assurances span { display: inline-flex; align-items: center; gap: 8px; }
  .pricing-assurances .icon { color: #5b7300; }
  .comparison-scroll { max-width: 100%; overflow-x: auto; contain: layout paint; }
  table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: 0.8rem; }
  th, td { padding: 20px 24px; border-bottom: 1px solid var(--line); text-align: center; }
  thead th { padding-top: 24px; padding-bottom: 24px; background: var(--ink); color: var(--white); font-family: var(--display); font-size: 1.4rem; font-weight: 600; letter-spacing: 0.01em; text-transform: uppercase; }
  thead th:first-child { width: 40%; text-align: left; }
  tbody th { font-weight: 600; text-align: left; }
  td { color: var(--muted); }
  td .icon { margin-inline: auto; color: #5b7300; }
  th.featured, td.featured { background: rgb(217 255 67 / 0.16); }
  thead th.featured { background: #2b301f; color: var(--lime); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .membership-every__grid { display: grid; grid-template-columns: 0.65fr 1fr; align-items: start; gap: clamp(56px, 8vw, 110px); }
  .essentials-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
  .essentials-grid article > .icon { margin-bottom: 20px; color: #5b7300; }
  .essentials-grid h3 { font-size: 1.8rem; }
  .essentials-grid p { margin-top: 12px; color: var(--muted); font-size: 0.78rem; }
  .faq-grid { display: grid; grid-template-columns: 0.65fr 1fr; align-items: start; gap: clamp(56px, 8vw, 110px); }
  .faq-grid > div:first-child > p:not(.eyebrow) { max-width: 360px; margin: 24px 0; color: var(--muted); font-size: 0.84rem; }

  @media (max-width: 900px) {
    .pricing-toolbar { align-items: flex-start; flex-direction: column; }
    .billing-control { justify-items: start; }
    .membership-every__grid, .faq-grid { grid-template-columns: 1fr; gap: 44px; }
  }
  @media (max-width: 640px) {
    .pricing-toolbar { margin-bottom: 48px; }
    .billing-toggle button { padding-inline: 13px; font-size: 0.62rem; }
    .billing-control > p { max-width: 300px; }
    .pricing-assurances { align-items: flex-start; flex-direction: column; gap: 12px; }
    .essentials-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
