---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BlogCard from '../../components/BlogCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { posts, type Post } from '../../data/gym';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
interface Props { post: Post; }
const { post } = Astro.props;
const related = posts.filter((item) => item.slug !== post.slug).sort((a, b) => Number(b.category === post.category) - Number(a.category === post.category)).slice(0, 3);
const authorImage = post.author === 'Marcus Reed' ? '/images/trainer-marcus.jpg' : post.author === 'Maya Chen' ? '/images/trainer-maya.jpg' : post.author === 'Sofia Patel' ? '/images/trainer-sofia.jpg' : post.author === 'Elena Rivera' ? '/images/trainer-elena.jpg' : post.author === 'Jordan Brooks' ? '/images/trainer-jordan.jpg' : '/images/trainer-dre.jpg';
---
<BaseLayout title={post.title} description={post.excerpt} image={post.image}>
  <article>
    <header class="article-hero">
      <div class="container">
        <div class="article-breadcrumbs"><a href="/">Home</a><span>/</span><a href="/blog">Journal</a><span>/</span><span>{post.category}</span></div>
        <div class="article-hero__meta"><span>{post.category}</span><time datetime={post.date}>{post.displayDate}</time><span>{post.readTime}</span></div>
        <h1>{post.title}</h1>
        <p class="article-hero__excerpt">{post.excerpt}</p>
        <div class="article-author">
          <img src={authorImage} alt={post.author} width="96" height="96" />
          <div><strong>{post.author}</strong><span>{post.authorRole} at FORGE</span></div>
        </div>
      </div>
    </header>

    <div class="container article-cover">
      <img src={post.image} alt="" width="1600" height="1000" fetchpriority="high" />
    </div>

    <div class="container article-layout">
      <aside class="article-aside">
        <div class="article-toc">
          <p class="meta">In this article</p>
          <nav aria-label="Article sections">
            {post.sections.map((section, index) => <a href={`#section-${index + 1}`}><span>0{index + 1}</span>{section.heading}</a>)}
          </nav>
        </div>
        <button class="copy-link" type="button" data-copy-link><Icon name="plus" size={15} /><span>Copy article link</span></button>
      </aside>
      <div class="article-content">
        {post.sections.map((section, index) => (
          <section id={`section-${index + 1}`}>
            <span class="article-content__number">0{index + 1}</span>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}
        <div class="article-disclaimer"><Icon name="activity" size={22} /><p>This article is general education, not medical advice. If you have an injury, health condition, or persistent pain, speak with a qualified healthcare professional.</p></div>
        <a class="text-link" href="/blog"><Icon name="arrow-left" size={16} />Back to all articles</a>
      </div>
    </div>
  </article>

  <section class="section section--white related-section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy"><p class="eyebrow">Keep reading</p><h2 class="section-title section-title--small">More from the journal.</h2></div>
        <a class="text-link" href="/blog">All articles<Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="card-grid">{related.map((item) => <BlogCard post={item} />)}</div>
    </div>
  </section>

  <CallToAction title="Good advice." accent="Better with a coach." description="Get feedback that’s specific to you with a free first session at FORGE." />
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copyButton?.addEventListener('click', async () => {
    const label = copyButton.querySelector('span');
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (label) label.textContent = 'Link copied';
    } catch {
      if (label) label.textContent = 'Copy unavailable';
    }
    window.setTimeout(() => { if (label) label.textContent = 'Copy article link'; }, 2200);
  });
</script>

<style>
  .article-hero { padding: calc(var(--header-height) + 66px) 0 80px; background: var(--ink); color: var(--white); }
  .article-breadcrumbs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 62px; color: var(--muted-dark); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .article-breadcrumbs a:hover { color: var(--lime); }
  .article-hero__meta { display: flex; flex-wrap: wrap; gap: 18px; margin-bottom: 22px; color: var(--muted-dark); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  .article-hero__meta span:first-child { color: var(--lime); }
  .article-hero__meta > *:not(:first-child)::before { margin-right: 18px; content: '·'; }
  h1 { max-width: 1100px; font-size: clamp(4rem, 8.3vw, 8rem); }
  .article-hero__excerpt { max-width: 690px; margin-top: 30px; color: #c5cabe; font-size: 1.02rem; }
  .article-author { display: flex; align-items: center; gap: 14px; margin-top: 36px; }
  .article-author img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .article-author div { display: grid; }
  .article-author strong { font-size: 0.76rem; }
  .article-author span { color: var(--muted-dark); font-size: 0.66rem; }
  .article-cover { position: relative; margin-top: -1px; background: var(--ink); }
  .article-cover::before { position: absolute; inset: 0 0 50%; z-index: 0; background: var(--ink); content: ''; }
  .article-cover img { position: relative; width: 100%; max-height: 720px; aspect-ratio: 1.85; object-fit: cover; }
  .article-layout { display: grid; grid-template-columns: 250px minmax(0, 720px); justify-content: center; gap: clamp(60px, 8vw, 120px); padding-block: clamp(70px, 9vw, 120px); }
  .article-aside { align-self: start; }
  .article-toc { position: sticky; top: calc(var(--header-height) + 32px); }
  .article-toc > .meta { margin-bottom: 18px; }
  .article-toc nav { display: grid; border-top: 1px solid var(--line); }
  .article-toc nav a { display: grid; grid-template-columns: 25px 1fr; gap: 8px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.68rem; font-weight: 600; line-height: 1.5; }
  .article-toc nav a:hover { color: var(--ink); }
  .article-toc nav a span { color: #5c7400; font-size: 0.58rem; }
  .copy-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 24px; padding: 0; background: transparent; color: var(--muted); font-size: 0.65rem; font-weight: 700; }
  .copy-link:hover { color: var(--ink); }
  .article-content > section { position: relative; margin-bottom: 64px; scroll-margin-top: calc(var(--header-height) + 32px); }
  .article-content__number { display: block; margin-bottom: 14px; color: #5b7300; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.09em; }
  .article-content h2 { margin-bottom: 26px; font-size: clamp(2.5rem, 4.4vw, 3.9rem); }
  .article-content p { margin-bottom: 20px; color: #4f544a; font-size: 0.97rem; line-height: 1.9; }
  .article-content ul { display: grid; gap: 12px; margin: 28px 0; padding: 26px 30px 26px 50px; background: var(--paper-deep); }
  .article-content li { padding-left: 4px; font-size: 0.86rem; }
  .article-content li::marker { color: #5b7300; }
  .article-disclaimer { display: flex; align-items: flex-start; gap: 16px; margin: 0 0 40px; padding: 22px; border: 1px solid var(--line); }
  .article-disclaimer .icon { flex: 0 0 auto; color: #5b7300; }
  .article-disclaimer p { margin: 0; color: var(--muted); font-size: 0.72rem; line-height: 1.7; }
  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; gap: 48px; }
    .article-aside { display: none; }
    .article-content { max-width: 720px; margin-inline: auto; }
    .article-cover img { aspect-ratio: 1.5; }
  }
  @media (max-width: 640px) {
    .article-hero { padding-top: calc(var(--header-height) + 48px); padding-bottom: 56px; }
    .article-breadcrumbs { margin-bottom: 44px; }
    h1 { font-size: clamp(3.5rem, 17vw, 5rem); }
    .article-hero__excerpt { font-size: 0.9rem; }
    .article-cover { width: 100%; }
    .article-cover img { aspect-ratio: 1.15; }
    .article-content p { font-size: 0.9rem; }
    .article-content ul { padding: 22px 22px 22px 42px; }
  }
</style>
