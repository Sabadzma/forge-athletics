---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrainerCard from '../components/TrainerCard.astro';
import PlanCard from '../components/PlanCard.astro';
import BlogCard from '../components/BlogCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { home, plans, posts, services, site, testimonials, trainers } from '../data/gym';
---
<BaseLayout title={site.name}>
  <section class="home-hero">
    <img class="home-hero__background" src={home.hero.image} alt={home.hero.imageAlt} width="1800" height="1200" fetchpriority="high" />
    <div class="home-hero__overlay"></div>
    <div class="container home-hero__inner">
      <div class="home-hero__content">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>
          <span>{home.hero.titleTop}</span>
          <span class="accent">{home.hero.titleAccent}</span>
          <span>{home.hero.titleBottom}</span>
        </h1>
        <div class="home-hero__intro">
          <p>{home.hero.description}</p>
          <div class="home-hero__actions">
            <a class="button button--lime" href="/contact?intent=trial">{home.hero.primaryCta}<Icon name="arrow-up-right" size={18} class="icon--arrow" /></a>
            <a class="button button--outline-light" href="#about">{home.hero.secondaryCta}<Icon name="arrow-right" size={18} /></a>
          </div>
        </div>
      </div>
      <div class="hero-review">
        <div class="hero-review__rating"><span>4.9</span><div><span class="hero-review__stars" aria-label="5 out of 5 stars">★★★★★</span><p>280+ local reviews</p></div></div>
        <p>“The rare gym that feels challenging and welcoming at the same time.”</p>
      </div>
    </div>
  </section>

  <section class="stats-strip" aria-label="FORGE at a glance">
    <div class="container stats-grid">
      {home.stats.map((stat) => <div class="stat"><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
    </div>
  </section>

  <section class="section manifesto" id="about">
    <div class="container manifesto-grid">
      <div>
        <p class="eyebrow">{home.manifesto.eyebrow}</p>
        <h2 class="section-title">{home.manifesto.title}</h2>
      </div>
      <div class="manifesto-copy">
        <p>{home.manifesto.body}</p>
        <a class="text-link" href="/services">How we train<Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">Ways to train</p>
          <h2 class="section-title">Find your way to stronger.</h2>
          <p>Train on your own, with a team, or one-to-one. Every option includes thoughtful guidance and room to progress.</p>
        </div>
        <a class="button button--outline-light" href="/services">All services<Icon name="arrow-up-right" size={17} /></a>
      </div>
      <div class="card-grid services-grid">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section method-section">
    <div class="container method-grid">
      <div class="method-media">
        <img src="/images/personal-training.jpg" alt="FORGE coach guiding an athlete through a strength exercise" width="1100" height="1300" loading="lazy" />
        <div class="method-media__badge"><strong>12</strong><span>years of<br />showing up</span></div>
      </div>
      <div class="method-content">
        <p class="eyebrow">The FORGE method</p>
        <h2 class="section-title section-title--small">A plan you can trust. People who know your name.</h2>
        <ol class="method-list">
          {home.method.map((step) => (
            <li>
              <span class="method-list__number">{step.number}</span>
              <div><h3>{step.title}</h3><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
        <a class="button button--dark" href="/contact?intent=trial">Meet your coach<Icon name="arrow-up-right" size={17} /></a>
      </div>
    </div>
    <div class="container amenities">
      {home.amenities.map((amenity) => <span><Icon name="check" size={16} />{amenity}</span>)}
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">Coaches in your corner</p>
          <h2 class="section-title">Expert eyes. Good humans.</h2>
          <p>Experienced coaches who listen first, explain the why, and know when to push.</p>
        </div>
        <a class="text-link" href="/trainers">Meet the full team<Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="card-grid">
        {trainers.slice(0, 3).map((trainer) => <TrainerCard trainer={trainer} />)}
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">Memberships</p>
          <h2 class="section-title">Simple pricing. Serious value.</h2>
          <p>No joining fee. No confusing tiers. Just choose how much guidance you want.</p>
        </div>
        <a class="text-link" href="/pricing">Compare memberships<Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="card-grid pricing-grid">
        {plans.map((plan) => <PlanCard plan={plan} />)}
      </div>
      <p class="pricing-note"><Icon name="check" size={16} />Every membership starts with a free first session. No payment details required.</p>
    </div>
  </section>

  <section class="section section--dark testimonials-section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">Member stories</p>
          <h2 class="section-title">Progress sounds like this.</h2>
        </div>
        <div class="testimonials-rating"><strong>4.9</strong><span>★★★★★<br />Average member rating</span></div>
      </div>
      <div class="testimonials-grid">
        {testimonials.map((testimonial) => (
          <blockquote class="testimonial">
            <Icon name="quote" size={30} />
            <p>“{testimonial.quote}”</p>
            <footer><span class="testimonial__avatar">{testimonial.initials}</span><div><cite>{testimonial.name}</cite><span>{testimonial.detail}</span></div></footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <p class="eyebrow">The FORGE journal</p>
          <h2 class="section-title">Useful reads. No fitness fads.</h2>
        </div>
        <a class="text-link" href="/blog">Read the journal<Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="card-grid">
        {posts.slice(0, 3).map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>

<style>
  .home-hero { position: relative; display: flex; min-height: min(900px, 100svh); align-items: center; padding: calc(var(--header-height) + 72px) 0 80px; background: var(--ink); color: var(--white); isolation: isolate; }
  .home-hero__background { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 65% center; }
  .home-hero__overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(13 15 12 / 0.98) 0%, rgb(13 15 12 / 0.91) 37%, rgb(13 15 12 / 0.35) 72%, rgb(13 15 12 / 0.28) 100%), linear-gradient(0deg, rgb(13 15 12 / 0.55), transparent 50%); }
  .home-hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: end; gap: 48px; }
  .home-hero__content { max-width: 890px; animation: hero-in 700ms both; }
  .home-hero .eyebrow { margin-bottom: 26px; color: var(--lime); }
  .home-hero .eyebrow::before { background: var(--lime); }
  h1 { font-size: clamp(5rem, 10.5vw, 9.6rem); line-height: 0.79; letter-spacing: -0.035em; }
  h1 > span { display: block; }
  h1 > span:last-child { margin-top: 0.08em; }
  h1 .accent { color: var(--lime); }
  .home-hero__intro { display: grid; grid-template-columns: minmax(240px, 430px) 1fr; align-items: end; gap: 34px; margin-top: 42px; }
  .home-hero__intro > p { color: #d1d6cb; font-size: 0.94rem; line-height: 1.75; }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .home-hero__actions .button { white-space: nowrap; }
  .hero-review { margin-bottom: 8px; padding: 22px; border: 1px solid rgb(255 255 255 / 0.25); background: rgb(17 19 15 / 0.65); backdrop-filter: blur(12px); animation: hero-in 700ms 150ms both; }
  .hero-review__rating { display: flex; align-items: center; gap: 14px; }
  .hero-review__rating > span { font-family: var(--display); font-size: 3.2rem; font-weight: 700; line-height: 1; }
  .hero-review__stars { color: var(--lime); font-size: 0.77rem; letter-spacing: 0.08em; }
  .hero-review__rating p { color: var(--muted-dark); font-size: 0.62rem; text-transform: uppercase; }
  .hero-review > p { margin-top: 15px; color: #e0e3db; font-size: 0.76rem; line-height: 1.6; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  .stats-strip { background: var(--lime); color: var(--ink); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { display: flex; align-items: center; gap: 16px; padding: 28px 26px; border-right: 1px solid rgb(21 23 19 / 0.2); }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: 0; }
  .stat strong { font-family: var(--display); font-size: 3.2rem; font-weight: 700; line-height: 1; }
  .stat span { max-width: 130px; font-size: 0.63rem; font-weight: 800; letter-spacing: 0.055em; line-height: 1.5; text-transform: uppercase; }

  .manifesto { background: var(--white); }
  .manifesto-grid { display: grid; grid-template-columns: 1.6fr 0.7fr; align-items: end; gap: 80px; }
  .manifesto .section-title { max-width: 900px; }
  .manifesto-copy { display: grid; gap: 28px; padding-bottom: 8px; }
  .manifesto-copy p { color: var(--muted); font-size: 0.95rem; }
  .manifesto-copy .text-link { justify-self: start; }

  .services-grid { row-gap: 28px; }
  .method-grid { display: grid; grid-template-columns: 0.92fr 1fr; align-items: center; gap: clamp(56px, 8vw, 120px); }
  .method-media { position: relative; min-height: 640px; }
  .method-media > img { width: 100%; height: 100%; min-height: 640px; object-fit: cover; }
  .method-media__badge { position: absolute; right: -36px; bottom: 40px; display: flex; align-items: center; gap: 12px; padding: 22px 28px; background: var(--lime); }
  .method-media__badge strong { font-family: var(--display); font-size: 4rem; line-height: 0.9; }
  .method-media__badge span { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.07em; line-height: 1.5; text-transform: uppercase; }
  .method-content .section-title { font-size: clamp(3.2rem, 5.2vw, 4.9rem); }
  .method-list { margin: 38px 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .method-list li { display: grid; grid-template-columns: 40px 1fr; gap: 16px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .method-list__number { padding-top: 4px; color: #607600; font-size: 0.66rem; font-weight: 800; letter-spacing: 0.08em; }
  .method-list h3 { font-size: 1.75rem; }
  .method-list p { margin-top: 9px; color: var(--muted); font-size: 0.8rem; line-height: 1.7; }
  .amenities { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 88px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .amenities span { display: flex; align-items: center; gap: 10px; padding: 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 0.72rem; font-weight: 700; }
  .amenities .icon { color: #5b7300; }

  .pricing-grid { padding-top: 14px; }
  .pricing-note { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 36px; color: var(--muted); font-size: 0.72rem; text-align: center; }
  .pricing-note .icon { color: #5c7400; }
  .testimonials-rating { display: flex; align-items: center; gap: 16px; }
  .testimonials-rating strong { font-family: var(--display); font-size: 4rem; line-height: 1; }
  .testimonials-rating span { color: var(--lime); font-size: 0.68rem; letter-spacing: 0.08em; line-height: 1.6; }
  .testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-dark); border-left: 1px solid var(--line-dark); }
  .testimonial { display: flex; min-height: 370px; flex-direction: column; margin: 0; padding: clamp(26px, 3.2vw, 42px); border-right: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark); }
  .testimonial > .icon { margin-bottom: 28px; color: var(--lime); }
  .testimonial > p { color: #e0e3da; font-family: var(--display); font-size: clamp(1.45rem, 2vw, 1.85rem); font-weight: 500; line-height: 1.25; text-transform: uppercase; }
  .testimonial footer { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 30px; }
  .testimonial__avatar { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid #555b4e; border-radius: 50%; color: var(--lime); font-size: 0.66rem; font-weight: 800; }
  .testimonial footer div { display: grid; }
  .testimonial cite { color: var(--white); font-size: 0.74rem; font-style: normal; font-weight: 700; }
  .testimonial footer div span { color: var(--muted-dark); font-size: 0.63rem; }

  @media (max-width: 1100px) {
    .home-hero__inner { grid-template-columns: 1fr 250px; }
    .home-hero__intro { grid-template-columns: 1fr; }
    .home-hero__actions { margin-top: -10px; }
    .stat { align-items: flex-start; flex-direction: column; gap: 6px; }
    .method-media { min-height: 560px; }
    .method-media > img { min-height: 560px; }
  }
  @media (max-width: 900px) {
    .home-hero { min-height: 850px; }
    .home-hero__inner { grid-template-columns: 1fr; }
    .hero-review { display: none; }
    .home-hero__content { max-width: 760px; }
    .home-hero__overlay { background: linear-gradient(90deg, rgb(13 15 12 / 0.95), rgb(13 15 12 / 0.58)), linear-gradient(0deg, rgb(13 15 12 / 0.65), transparent); }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stat { padding: 24px; border-bottom: 1px solid rgb(21 23 19 / 0.2); }
    .stat:nth-child(2) { border-right: 0; }
    .stat:first-child { padding-left: 24px; }
    .stat:nth-child(3), .stat:nth-child(4) { border-bottom: 0; }
    .manifesto-grid { grid-template-columns: 1fr; gap: 30px; }
    .manifesto-copy { max-width: 600px; }
    .method-grid { grid-template-columns: 1fr; }
    .method-media { min-height: 520px; }
    .method-media > img { min-height: 520px; max-height: 650px; }
    .method-media__badge { right: 24px; }
    .method-content { max-width: 700px; }
    .testimonials-grid { grid-template-columns: 1fr; }
    .testimonial { min-height: 300px; }
  }
  @media (max-width: 640px) {
    .home-hero { min-height: 780px; padding-top: calc(var(--header-height) + 58px); }
    .home-hero__background { object-position: 62% center; }
    h1 { font-size: clamp(4.8rem, 23vw, 7rem); }
    .home-hero__intro { margin-top: 30px; }
    .home-hero__actions { display: grid; grid-template-columns: 1fr; }
    .home-hero__actions .button { width: 100%; }
    .stat { padding: 20px 14px; }
    .stat:first-child { padding-left: 14px; }
    .stat strong { font-size: 2.65rem; }
    .stat span { font-size: 0.56rem; }
    .method-media, .method-media > img { min-height: 420px; }
    .method-media__badge { right: 0; bottom: 0; padding: 18px 22px; }
    .amenities { grid-template-columns: 1fr; margin-top: 64px; }
    .pricing-note { align-items: flex-start; text-align: left; }
    .testimonials-rating { align-self: flex-start; }
  }
</style>
