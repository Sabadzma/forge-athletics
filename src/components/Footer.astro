---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navigation, services, site } from '../data/gym';
const year = new Date().getFullYear();
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo />
      <p>{site.tagline}<br />A neighborhood gym for every body.</p>
      <div class="social-links">
        {site.social.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}<Icon name="arrow-up-right" size={13} /></a>)}
      </div>
    </div>
    <div class="footer-column">
      <h2>Explore</h2>
      <nav aria-label="Footer navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
    <div class="footer-column">
      <h2>Train</h2>
      <nav aria-label="Services navigation">
        {services.slice(0, 5).map((service) => <a href={`/services#${service.slug}`}>{service.shortTitle}</a>)}
      </nav>
    </div>
    <div class="footer-column footer-contact">
      <h2>Visit FORGE</h2>
      <a href={mapUrl} target="_blank" rel="noopener noreferrer">{site.address}</a>
      <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <p>Mon–Fri 5 AM–10 PM<br />Sat–Sun from 7 AM</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {site.legalName}. Demo content for a fictional gym.</p>
    <a href="/contact">Start your first session <Icon name="arrow-up-right" size={14} /></a>
  </div>
</footer>

<style>
  .site-footer { padding-top: 80px; background: #10120e; color: var(--white); }
  .footer-grid { display: grid; grid-template-columns: 1.7fr 0.75fr 0.9fr 1.3fr; gap: 64px; padding-bottom: 72px; }
  .footer-brand > p { margin-top: 24px; color: var(--muted-dark); font-size: 0.88rem; }
  .social-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 30px; }
  .social-links a { display: inline-flex; align-items: center; gap: 4px; color: #d8ddd1; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .social-links a:hover { color: var(--lime); }
  .footer-column h2 { margin-bottom: 24px; color: var(--muted-dark); font-family: var(--body); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.14em; }
  .footer-column nav { display: grid; gap: 11px; }
  .footer-column a { color: #d8ddd1; font-size: 0.82rem; transition: color 160ms ease; }
  .footer-column a:hover { color: var(--lime); }
  .footer-contact { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .footer-contact h2 { margin-bottom: 12px; }
  .footer-contact a:first-of-type { max-width: 230px; }
  .footer-contact p { margin-top: 10px; color: var(--muted-dark); font-size: 0.76rem; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 24px; border-top: 1px solid var(--line-dark); color: var(--muted-dark); font-size: 0.68rem; }
  .footer-bottom a { display: inline-flex; align-items: center; gap: 6px; color: var(--white); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .footer-bottom a:hover { color: var(--lime); }

  @media (max-width: 980px) {
    .footer-grid { grid-template-columns: 1.5fr 1fr 1fr; gap: 48px; }
    .footer-contact { grid-column: 2 / -1; }
  }
  @media (max-width: 640px) {
    .site-footer { padding-top: 64px; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 44px 28px; padding-bottom: 52px; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-contact { grid-column: 1 / -1; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
