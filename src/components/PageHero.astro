---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
}
const { eyebrow, title, accent, description } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <div class="page-hero__breadcrumbs"><a href="/">Home</a><span>/</span><span>{eyebrow}</span></div>
    <div class="page-hero__grid">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="page-hero__title">{title}{accent && <><br /><span class="accent">{accent}</span></>}</h1>
      </div>
      <div class="page-hero__copy">
        <p>{description}</p>
        <slot />
      </div>
    </div>
  </div>
</section>
